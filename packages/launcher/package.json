{
  "name": "@ledmon/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "LED Monitor: runs the monitoring server from the menu bar",
  "author": "Horinetech",
  "main": "app/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:windows": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.horinetech.ledmonitor",
    "productName": "LED Monitor",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "LED Monitor reads the status of the LED processors on your local network and sends the controls you choose."
      }
    },
    "dmg": {
      "title": "LED Monitor ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "LED-Monitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LED Monitor",
      "runAfterFinish": true
    }
  }
}
